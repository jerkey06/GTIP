# Copia este archivo como .env y ajusta los valores. .env NUNCA se sube a Git.

APP_ENV=development
# Genera uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL (lo usa compose.yaml para crear la base de datos)
POSTGRES_USER=gtip
POSTGRES_PASSWORD=gtip
POSTGRES_DB=gtip
# Para correr la API fuera de Docker contra el contenedor db:
DATABASE_URL=postgresql+psycopg://gtip:gtip@localhost:5432/gtip
# Base de datos SOLO para pytest (se borra y recrea en cada ejecución). La crea
# docker/postgres-init la primera vez que se levanta el contenedor db.
TEST_DATABASE_URL=postgresql+psycopg://gtip:gtip@localhost:5432/gtip_test

# Fuentes. CISA KEV, NVD y URLhaus funcionan sin clave; NVD y URLhaus admiten una
# opcional (más cuota). AbuseIPDB y OTX son opcionales y no tienen conector en el MVP.
CISA_KEV_ENABLED=true
NVD_ENABLED=true
URLHAUS_ENABLED=true
# Gratis en https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Gratis en https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Worker de ingesta
INGESTION_POLL_INTERVAL_SECONDS=10
INGESTION_MAX_RETRIES=3
# Frecuencia por fuente en minutos (0 = sin planificación, solo manual)
CISA_KEV_INTERVAL_MINUTES=720
NVD_INTERVAL_MINUTES=120
URLHAUS_INTERVAL_MINUTES=60
# Días hacia atrás en la primera sincronización de NVD (1-120)
NVD_INITIAL_DAYS=7
# Minutos tras los que una ejecución en curso se considera abandonada
INGESTION_STALE_AFTER_MINUTES=60
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Intentos de login por IP y minuto
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Opcional: carpeta con el frontend compilado para servirlo desde la propia API
# FRONTEND_DIST_DIR=../frontend/dist

# Inicio de sesión con Google y GitHub (opcional). Cada proveedor se activa al definir
# su client id y su secret. URL de retorno autorizada en cada consola:
#   {PUBLIC_URL}/api/v1/auth/oauth/google/callback
#   {PUBLIC_URL}/api/v1/auth/oauth/github/callback
# PUBLIC_URL es la dirección pública del sitio (la del frontend).
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clerk (alternativa al login propio): Google, GitHub y correo sin configurar apps OAuth.
# La clave publicable es pública. En el frontend se define como VITE_CLERK_PUBLISHABLE_KEY
# al compilar (p. ej. en Cloudflare Pages); en el backend como CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=

# Consulta de datos sin iniciar sesión (por defecto sí). La búsqueda y solicitar ingestas
# siguen requiriéndola. Con false todo vuelve a requerir sesión.
PUBLIC_READ_ACCESS=true
# Worker de ingesta dentro de la API (hosting sin proceso aparte, p. ej. Render gratis).
EMBEDDED_WORKER=false
